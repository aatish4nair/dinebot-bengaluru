__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/

# Pipeline-generated intermediate data (regenerated by `python -m data_ingestion.ingestion_pipeline`
# and `python -m features.feature_pipeline`). Not source - don't version these.
# The raw Hugging Face cache alone is 500MB+, over GitHub's 100MB file limit.
data_ingestion/data/
features/data/raw/
features/data/silver/

# features/data/gold/zomato_gold.parquet is intentionally NOT ignored and stays committed:
# it's the one file the live web app reads at request time. Without it tracked, a fresh
# deploy/clone has no data to serve until someone manually reruns both pipelines.

# Ad-hoc zip backups (not source - also over GitHub's limit).
*.zip

# Secrets - never commit real API keys
.env

.DS_Store
